# ==== PRODUCCIÓN ====
# Copia como backend/.env en el servidor y completa los valores marcados con <...>.
# Después: php artisan key:generate (solo la PRIMERA vez: cambiar APP_KEY hace ilegibles
# los teléfonos y notas cifrados de los pedidos) y php artisan config:cache.

APP_NAME="Diana Store"
APP_ENV=production
APP_KEY=
# Nunca true en producción: mostraría trazas con datos internos y personales.
APP_DEBUG=false
APP_URL=https://<tu-dominio>
FRONTEND_URL=https://<tu-dominio>
SANCTUM_STATEFUL_DOMAINS=<tu-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# IPs del proxy/CDN que termina HTTPS (o * si solo es accesible a través de él).
TRUSTED_PROXIES=*

# Versión de la política de privacidad vigente (cámbiala si modificas el texto).
PRIVACY_POLICY_VERSION=2026-11-15

# Admin inicial creado por "php artisan db:seed" (mínimo 12 caracteres).
# También puedes usar "php artisan admin:create correo@dominio" y dejar esto vacío.
ADMIN_EMAIL=
ADMIN_PASSWORD=

BCRYPT_ROUNDS=12

# Logs diarios, 14 días, sin nivel debug.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tienda
DB_USERNAME=tienda
# Igual que DB_PASSWORD del .env de la raíz.
DB_PASSWORD=<contraseña-larga-aleatoria>

SESSION_DRIVER=database
# El panel se cierra tras 60 minutos de inactividad.
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=<tu-dominio>
# Cookies solo por HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Correo del Libro de Reclamaciones (constancias y respuestas). Ej.: Brevo, Resend, Gmail con contraseña de aplicación.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<smtp.proveedor.com>
MAIL_PORT=465
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<contraseña>
MAIL_FROM_ADDRESS="reclamos@<tu-dominio>"
MAIL_FROM_NAME="${APP_NAME}"
